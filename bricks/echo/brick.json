{
    "name": "Echo Brick",
    "id": "echo",
    "version": "1.0.0",
    "description": "Simple example brick that echoes messages back. Use this as a template for creating new bricks.",
    "author": "Enigma Engine",
    "port": 9910,
    "commands": [
        {
            "name": "echo",
            "description": "Echo back a message",
            "args": {
                "message": {"type": "string", "required": true, "description": "Message to echo back"}
            }
        },
        {
            "name": "reverse",
            "description": "Reverse a string",
            "args": {
                "text": {"type": "string", "required": true, "description": "Text to reverse"}
            }
        },
        {
            "name": "count",
            "description": "Count words in text",
            "args": {
                "text": {"type": "string", "required": true, "description": "Text to count words in"}
            }
        },
        {
            "name": "status",
            "description": "Get brick status"
        },
        {
            "name": "stop",
            "description": "Stop the brick"
        }
    ],
    "ui": {
        "layout": "vertical",
        "widgets": [
            {"type": "text_input", "id": "message", "label": "Message"},
            {"type": "button", "id": "echo", "label": "Echo", "command": "echo"},
            {"type": "button", "id": "reverse", "label": "Reverse", "command": "reverse"}
        ]
    },
    "prompt": "For echo/test tasks, use: brick.send echo echo <message> or brick.send echo reverse <text>",
    "dependencies": [],
    "settings": {}
}
